{% set page_title = post.title %}
{% include "header.html" %}
    {% set page_desc = post.excerpt | default('A blog post by Leo Mercer.') %}
    
    <section class="container">
        <!-- Breadcrumb -->
        <nav style="padding-top: 2rem; font-size: 0.8rem; color: var(--overlay0); margin-bottom: 1rem;">
            <a href="/posts.html" style="color: var(--overlay0) !important;">Blog</a> / 
            <span style="color: var(--text);">{{ post.title }}</span>
        </nav>

        <!-- Post Header -->
        <article>
            <h1 style="font-size: clamp(1.6rem, 4vw, 2.5rem); font-weight: 800; color: var(--text); margin-bottom: 0.5rem;">{{ post.title }}</h1>
            <div style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap; margin-bottom: 2rem; font-size: 0.82rem; color: var(--subtext0);">
                <span>{{ post.date }}</span>
                {% for tag in post.tags %}
                <span class="tag tag-{{ ['blue','mauve','green','teal'][loop.index0 % 4] }}">{{ tag }}</span>
                {% endfor %}
            </div>

            <!-- Post Content (injected by build script) -->
            <div style="max-width: 720px;">
                {{ post_content }}
            </div>
        </article>

        <!-- Back to posts -->
        <a href="/posts.html" style="display:inline-flex; align-items:center; gap:0.3rem; margin-top: 3rem; font-size: 0.85rem; color: var(--blue) !important;">← Back to all posts</a>
    </section>

{% include "footer.html" %}
